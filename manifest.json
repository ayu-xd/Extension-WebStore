{
	"manifest_version": 3,
	"name": "DMDroid",
	"short_name": "DMDroid",
	"version": "1.4.4",
	"description": "Your Instagram DM follow-up assistant — schedule first touches and follow-ups, track replies, and stay organized.",
	"icons": {
		"16": "icons/icon-16x16.png",
		"48": "icons/icon-48x48.png",
		"128": "icons/icon-128x128.png"
	},
	"permissions": ["storage", "tabs", "alarms"],
	"host_permissions": ["*://*.instagram.com/*"],
	"action": {
		"default_title": "DMDroid",
		"default_popup": "popup/index.html"
	},
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["*://*.instagram.com/*"],
			"all_frames": true,
			"match_origin_as_fallback": true,
			"run_at": "document_start",
			"js": ["assets/InjectVisibility.js", "assets/HackReact.js"]
		},
		{
			"matches": ["*://*.instagram.com/*"],
			"run_at": "document_end",
			"js": ["assets/content.js"]
		}
	],
	"web_accessible_resources": [
		{
			"resources": [
				"assets/dom.js",
				"assets/HackVisibility.js",
				"assets/ReactDev.js",
				"assets/ReadReceipts.js"
			],
			"matches": ["*://*.instagram.com/*"]
		}
	]
}
